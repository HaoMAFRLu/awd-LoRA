{
    "architectures": [
        "LLaMAForCausalLM"
    ],
    "bos_token_id": 0,
    "eos_token_id": 1,
    "hidden_act": "silu",
    "hidden_size": 512,
    "intermediate_size": 1376,
    "initializer_range": 0.02,
    "max_position_embeddings": 1024,
    "model_type": "llama",
    "num_attention_heads": 8,
    "num_hidden_layers": 3,
    "pad_token_id": 0,
    "rms_norm_eps": 1e-06,
    "transformers_version": "4.57.6",
    "use_cache": false,
    "vocab_size": 32000,
    "loop": {
        "num_entry_blocks": 1,
        "num_blocks_per_loop": 1,
        "num_exit_blocks": 1,
        "num_loops": 6,
        "max_num_loops": 6
    },
    "consensus_salaad": {
        "components": [
            "shared",
            "sparse"
        ],
        "target_modules": [
            "self_attn.q_proj",
            "self_attn.k_proj",
            "self_attn.v_proj",
            "self_attn.o_proj",
            "mlp.gate_proj",
            "mlp.up_proj",
            "mlp.down_proj"
        ]
    }
}
