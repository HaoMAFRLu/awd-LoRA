# Direct Hungarian projection of the final soft P_e, then held-out NLL/PPL.
universe        = vanilla
executable      = /usr/bin/env
arguments       = \
    /lustre/home/hma2/projects/awd-LoRA/myenv/bin/python \
    -u scripts/evaluate_moe_hard_projection.py \
    --checkpoint data/moe/ns97m_sinkhorn_10k/17684559_0/checkpoints/step_00002100 \
    --data-manifest data/moe_corpora/dclm_20260916/tokens_ns97m/manifest.json \
    --expected-step 2100 \
    --expected-config-hash 67406ce938e46852ce2fd65f8a049ac67fa0bc2d42272b2c67b6f8a7601142d9 \
    --expected-corpus-identity af6ff01895161e92706b337e8c306a92f81936e1cc4cfa0b1ff17514b8775034 \
    --split validation --device cuda --batch-size 4 --cpu-threads 4 \
    --output data/moe_evaluation/ns97m_sinkhorn_10k_hard/$(Cluster)_$(Process)

initialdir      = /lustre/home/hma2/projects/awd-LoRA
log             = jobs/moe_ns97m_sinkhorn_10k_hard_evaluation_$(Cluster)_$(Process).log
error           = jobs/moe_ns97m_sinkhorn_10k_hard_evaluation_$(Cluster)_$(Process).err
