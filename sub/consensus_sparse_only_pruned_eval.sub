    !regexp("GPU-4c275e72", TARGET.DetectedGPUs) && \
    !regexp("GPU-a0e440fb", TARGET.DetectedGPUs) && \
    !regexp("GPU-b50eee5a", TARGET.DetectedGPUs) && \
    !regexp("GPU-57cf3c62", TARGET.DetectedGPUs) && \
    !regexp("GPU-b65aba4e", TARGET.DetectedGPUs) && \
    !regexp("GPU-90f1a7d5", TARGET.DetectedGPUs) && \
    !regexp("GPU-2d57d3d7", TARGET.DetectedGPUs) && \
    !regexp("GPU-1feef0b3", TARGET.DetectedGPUs) && \
    !regexp("GPU-a82810cc", TARGET.DetectedGPUs) \
)

