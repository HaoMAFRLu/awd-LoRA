executable = /lustre/home/hma2/projects/awd-LoRA/myenv/bin/python

arguments = \
    -u -m torch.distributed.run \
    --nproc_per_node=4 \
    --nnodes=1 \
    --rdzv_backend=c10d \
    --rdzv_endpoint=127.0.0.1:29519 \
    scripts/evaluate_consensus_c4.py \
    --config configs/llama_consensus_sparse_only_pruned_c4_eval.yaml

initialdir = /lustre/home/hma2/projects/awd-LoRA

