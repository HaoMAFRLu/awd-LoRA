# Generate the DAGMan submit file with -no_submit and the agreed bid minus 1000
# as -priority, then submit that generated file with condor_submit_bid.
# Export DEFAULT_JOB_BID to the same bid when submitting: the cluster's
# condor_submit wrapper otherwise resets DAG child jobs to bid 1.
JOB PREPARE sub/moe_ns97m_prepare.sub
JOB VANILLA sub/moe_ns97m_vanilla.sub
JOB SALAAD sub/moe_ns97m_salaad.sub

# PREPARE checks corpus sizes on its CPU worker before reporting success.
# Both training runs become eligible as soon as the same corpus is ready.
PARENT PREPARE CHILD VANILLA SALAAD
