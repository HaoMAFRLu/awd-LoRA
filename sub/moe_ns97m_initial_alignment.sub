# Step-zero channel-similarity assignments only; no training and no W&B.
universe        = vanilla
executable      = /usr/bin/env
arguments       = \
    /lustre/home/hma2/projects/awd-LoRA/myenv/bin/python \
    -u scripts/analyze_moe_initial_alignment.py \
    --config configs/ns97m_sinkhorn_10k_first_update.yaml \
    --output data/moe_analysis/initial_alignment_20261008/$(Cluster)_$(Process) \
    --device cuda --cpu-threads 4 --reference-expert 0

initialdir      = /lustre/home/hma2/projects/awd-LoRA
log             = jobs/moe_ns97m_initial_alignment_$(Cluster)_$(Process).log
error           = jobs/moe_ns97m_initial_alignment_$(Cluster)_$(Process).err
output          = jobs/moe_ns97m_initial_alignment_$(Cluster)_$(Process).out

request_cpus    = 4
request_memory  = 16000
request_gpus    = 1
requirements = ( \
    CUDACapability >= 9.0 && CUDACapability < 9.1 && CUDAGlobalMemoryMb >= 80000 && \
    TARGET.Machine != "i106.internal.cluster.is.localnet" && \
    TARGET.Machine != "i203.internal.cluster.is.localnet" && \
    TARGET.Machine != "i205.internal.cluster.is.localnet" && \
    !regexp("GPU-a82810cc", TARGET.DetectedGPUs) && \
    !regexp("GPU-1f35d697", TARGET.DetectedGPUs) && \
    !regexp("GPU-45d24b88", TARGET.DetectedGPUs) && \
    !regexp("GPU-0e5a23fb", TARGET.DetectedGPUs) && \
    !regexp("GPU-b211f480", TARGET.DetectedGPUs) \
)
should_transfer_files = NO
getenv          = True
environment     = "OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 WANDB_MODE=disabled"

queue 1
