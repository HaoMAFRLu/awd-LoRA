# Tokenize the downloaded DCLM shards on a CPU worker before GPU training.
universe        = vanilla
executable      = /lustre/home/hma2/projects/awd-LoRA/myenv/bin/python
arguments       = \
    -u scripts/prepare_moe_data.py \
    --config configs/ns97m_vanilla.yaml \
    --shard-manifest /lustre/home/hma2/projects/awd-LoRA/data/moe_corpora/dclm_20260916/sources/shards.json \
    --tokenizer-json /lustre/home/hma2/projects/awd-LoRA/data/moe_corpora/dclm_20260916/sources/tokenizer/tokenizer.json \
    --max-train-tokens 4404019200 \
    --output /lustre/home/hma2/projects/awd-LoRA/data/moe_corpora/dclm_20260916/tokens_ns97m

initialdir      = /lustre/home/hma2/projects/awd-LoRA

log             = jobs/moe_ns97m_prepare_$(Cluster)_$(Process).log
error           = jobs/moe_ns97m_prepare_$(Cluster)_$(Process).err
output          = jobs/moe_ns97m_prepare_$(Cluster)_$(Process).out

request_cpus    = 2
request_memory  = 16000
request_gpus    = 0

should_transfer_files = NO
getenv          = True
environment     = "OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 RAYON_NUM_THREADS=2 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1"

queue 1
