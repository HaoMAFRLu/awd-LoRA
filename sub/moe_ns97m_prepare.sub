# Tokenize the downloaded DCLM shards on a CPU worker before GPU training.
universe        = vanilla
executable      = /bin/bash
arguments       = scripts/prepare_ns97m_corpus.sh

initialdir      = /lustre/home/hma2/projects/awd-LoRA

log             = jobs/moe_ns97m_prepare_$(Cluster)_$(Process).log
error           = jobs/moe_ns97m_prepare_$(Cluster)_$(Process).err
output          = jobs/moe_ns97m_prepare_$(Cluster)_$(Process).out

request_cpus    = 2
request_memory  = 16000
request_gpus    = 0

should_transfer_files = NO
getenv          = True
environment     = "OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 RAYON_NUM_THREADS=2 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1"

queue 1
