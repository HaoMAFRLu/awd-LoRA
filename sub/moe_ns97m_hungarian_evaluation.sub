# Evaluate first, then inspect all consensus / expert-specific / permutation matrices.
universe        = vanilla
executable      = /usr/bin/env
arguments       = \
    /lustre/home/hma2/projects/awd-LoRA/myenv/bin/python \
    -u scripts/evaluate_moe_comparison.py \
    --config configs/eval_ns97m_hungarian.yaml \
    --suite nll \
    --split validation \
    --device cuda \
    --batch-size 4 \
    --cpu-threads 4 \
    --matrix-norms \
    --output data/moe_evaluation/ns97m_hungarian/$(Cluster)_$(Process)

initialdir      = /lustre/home/hma2/projects/awd-LoRA
log             = jobs/moe_ns97m_hungarian_evaluation_$(Cluster)_$(Process).log
error           = jobs/moe_ns97m_hungarian_evaluation_$(Cluster)_$(Process).err
output          = jobs/moe_ns97m_hungarian_evaluation_$(Cluster)_$(Process).out

request_cpus    = 4
request_memory  = 32000
request_gpus    = 1

requirements = ( \
    CUDACapability >= 9.0 && \
    CUDACapability < 9.1 && \
    CUDAGlobalMemoryMb >= 80000 && \
    TARGET.Machine != "i106.internal.cluster.is.localnet" && \
    TARGET.Machine != "i203.internal.cluster.is.localnet" && \
    TARGET.Machine != "i205.internal.cluster.is.localnet" && \
    !regexp("GPU-a82810cc", TARGET.DetectedGPUs) && \
    !regexp("GPU-1f35d697", TARGET.DetectedGPUs) && \
    !regexp("GPU-45d24b88", TARGET.DetectedGPUs) && \
    !regexp("GPU-0e5a23fb", TARGET.DetectedGPUs) && \
    !regexp("GPU-b211f480", TARGET.DetectedGPUs) \
)

should_transfer_files = NO
getenv          = True
environment     = "OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 TOKENIZERS_PARALLELISM=false PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"

queue 1
