# Original soft Sinkhorn config; pause after the first P_e update; no W&B.
universe        = vanilla
executable      = /bin/bash
arguments       = \
    scripts/run_moe_first_pe_update.sh \
    /lustre/home/hma2/projects/awd-LoRA/data/moe/ns97m_sinkhorn_10k_first_update/$(Cluster)_$(Process)

initialdir      = /lustre/home/hma2/projects/awd-LoRA
log             = jobs/moe_ns97m_sinkhorn_10k_first_update_$(Cluster)_$(Process).log
error           = jobs/moe_ns97m_sinkhorn_10k_first_update_$(Cluster)_$(Process).err
output          = jobs/moe_ns97m_sinkhorn_10k_first_update_$(Cluster)_$(Process).out

request_cpus    = 16
request_memory  = 64000
request_gpus    = 4

# Preserve the original H100 selection and hardware exclusions.
requirements = ( \
    CUDACapability >= 9.0 && \
    CUDACapability < 9.1 && \
    CUDAGlobalMemoryMb >= 80000 && \
    TARGET.Machine != "i106.internal.cluster.is.localnet" && \
    TARGET.Machine != "i203.internal.cluster.is.localnet" && \
    TARGET.Machine != "i205.internal.cluster.is.localnet" && \
    !regexp("GPU-a82810cc", TARGET.DetectedGPUs) && \
    !regexp("GPU-1f35d697", TARGET.DetectedGPUs) && \
    !regexp("GPU-45d24b88", TARGET.DetectedGPUs) && \
    !regexp("GPU-0e5a23fb", TARGET.DetectedGPUs) && \
    !regexp("GPU-b211f480", TARGET.DetectedGPUs) \
)

should_transfer_files = NO
getenv          = True
environment     = "OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 WANDB_MODE=disabled PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"

queue 1
